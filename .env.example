# `scripts/docker.sh deploy` 会在缺少 .env 时自动生成安全随机值。
# 手工部署时可复制本文件，并替换所有 replace-* 占位值。
# ADMIN 三项必须全部填写或全部留空。全缺或全空会禁用启动期管理员引导；
# 部分填写、空值混用、短密码、占位值或非法邮箱都会阻止部署。
# 用户名长度 2..64，密码至少 16 字符，邮箱最长 128 字符（自动生成值含 32 字节随机性）。
AUTH_SECRET=replace-with-a-long-random-secret
MYSQL_ROOT_PASSWORD=replace-with-a-random-root-password
MYSQL_USER=hps
MYSQL_PASSWORD=replace-with-a-random-application-password
HPS_HTTP_PORT=18080
ADMIN_USERNAME=replace-admin
ADMIN_PASSWORD=replace-with-a-secure-admin-password
ADMIN_EMAIL=replace-admin@localhost.invalid
