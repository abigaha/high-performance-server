      "id": "file:logger/include/logger.h",
      "type": "file",
      "name": "logger/include/logger.h",
      "summary": "日志模块核心头文件，定义日志级别枚举、日志事件 LogEvent、单例日志器 Logger（含嵌套协程作用域类）及静态便捷日志 API，支持协程 ID 关联、多追加器与 init/shutdown 两阶段生命周期管理。",
      "tags": ["logging", "header", "singleton", "coroutine", "cpp"],
      "complexity": "moderate",
      "filePath": "logger/include/logger.h"
    },
    {
      "id": "class:logger/include/logger.h:LogAppender",
      "type": "class",
      "name": "LogAppender",
      "summary": "日志追加器的前置声明接口，Logger 通过 appenders_ 列表持有多个追加器实例，用于定义日志输出的目的地（如控制台、文件等）。",
      "tags": ["logging", "appender", "interface"],
      "complexity": "simple",
      "lineRange": "13-13"
    },
    {
      "id": "class:logger/include/logger.h:LogEvent",
      "type": "class",
      "name": "LogEvent",
      "summary": "日志事件类，封装单条日志的源文件名、行号、线程 ID、程序运行耗时、时间戳、协程 ID、日志器名称与内容等元信息，并提供相应访问器。",
      "tags": ["logging", "event", "metadata", "source-location"],
      "complexity": "simple",
      "lineRange": "19-51"
    },
    {
      "id": "class:logger/include/logger.h:Logger",
      "type": "class",
      "name": "Logger",
      "summary": "单例日志器，持有原子日志级别与追加器列表，提供 debug/info/warn/error/fatal 各级别日志输出、静态便捷 API、协程 ID 管理以及 init/shutdown 两阶段生命周期控制。",
      "tags": ["logging", "singleton", "coroutine", "thread-safe"],
      "complexity": "moderate",
      "lineRange": "54-141"
    },
    {
      "id": "class:logger/include/logger.h:CoroutineScope",
      "type": "class",
      "name": "CoroutineScope",
      "summary": "Logger 内部嵌套的 RAII 作用域类，构造时设置当前协程 ID、析构时恢复先前协程 ID，用于将日志输出与协程执行上下文关联。",
      "tags": ["logging", "coroutine", "raii"],
      "complexity": "simple",
