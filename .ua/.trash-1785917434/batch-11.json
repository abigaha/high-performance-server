{
  "nodes": [
    {
      "id": "file:net/tcp/tcp_server/include/connection.h",
      "type": "file",
      "name": "connection.h",
      "filePath": "net/tcp/tcp_server/include/connection.h",
      "summary": "TCP 连接封装头文件，管理单个客户端连接的读写缓冲区、SSL 状态与连接生命周期，并提供协程化的非阻塞读写 await 对象（ReadAwaiter/WriteAwaiter），供事件循环与 handler 线程跨线程安全使用。",
      "tags": ["tcp", "connection", "ssl", "coroutine", "buffer"],
      "complexity": "complex"
    },
    {
      "id": "class:net/tcp/tcp_server/include/connection.h:Connection",
      "type": "class",
      "name": "Connection",
      "lineRange": {"start": 27, "end": 146},
      "summary": "封装单个客户端 TCP 连接，含非阻塞读写缓冲区（互斥锁保护，写偏移避免 erase 开销）、SSL 对象与状态管理，继承 enable_shared_from_this 支持异步安全持引用，并提供协程化 await_read/await_write 接口。",
      "tags": ["tcp-connection", "buffer", "ssl", "coroutine", "mutex"],
      "complexity": "complex"
    },
    {
      "id": "class:net/tcp/tcp_server/include/connection.h:ReadAwaiter",
      "type": "class",
      "name": "ReadAwaiter",
      "lineRange": {"start": 156, "end": 165},
      "summary": "非阻塞读协程可等待对象，由 Connection::await_read 返回，co_await 时执行非阻塞读并返回读取结果，当前为立即 resume 的简单实现。",
      "tags": ["coroutine", "awaiter", "io"],
      "complexity": "simple"
    },
    {
      "id": "class:net/tcp/tcp_server/include/connection.h:WriteAwaiter",
      "type": "class",
      "name": "WriteAwaiter",
      "lineRange": {"start": 172, "end": 181},
      "summary": "非阻塞写协程可等待对象，由 Connection::await_write 返回，co_await 时执行非阻塞写并返回写入结果。",
      "tags": ["coroutine", "awaiter", "io"],
      "complexity": "simple"
    },
    {
      "id": "file:net/tcp/tcp_server/include/tcp_server.h",
      "type": "file",
      "name": "tcp_server.h",
      "filePath": "net/tcp/tcp_server/include/tcp_server.h",
      "summary": "基于 epoll ET + LockFreeThreadPool 的高性能 TCP 服务器声明头文件，定义服务器配置（端口/backlog/线程数/超时）、连接表管理、SSL 双模式支持与跨线程 eventfd 唤醒机制，实现 ITcpServer 接口。",
      "tags": ["tcp-server", "epoll", "thread-pool", "ssl", "event-loop"],
      "complexity": "complex"
    },
    {
      "id": "class:net/tcp/tcp_server/include/tcp_server.h:TcpServer",
      "type": "class",
      "name": "TcpServer",
      "lineRange": {"start": 27, "end": 130},
      "summary": "实现 ITcpServer 接口的 TCP 服务器，主事件循环基于 epoll 边缘触发分发 accept/read/write/SSL 握手事件，管理活跃连接表与 LockFreeThreadPool，支持优雅关闭（SIGINT/SIGTERM）、dirty 连接跨线程回传与 eventfd 唤醒。",
      "tags": ["epoll", "tcp-server", "ssl", "event-loop", "thread-pool"],
      "complexity": "complex"
    }
  ],
