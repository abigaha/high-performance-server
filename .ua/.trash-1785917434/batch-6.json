    },
    {
      "id": "class:db/include/chunk_lifecycle_coordinator.h:ChunkLifecycleCoordinator",
      "type": "class",
      "name": "ChunkLifecycleCoordinator",
      "summary": "协调分片上传与清理互斥的线程安全类，通过 UploadGuard、CleanupGuard 与 CleanupPermit 实现 RAII 语义，维护线程级上传计数与等待清理队列。",
      "tags": ["concurrency", "synchronization", "raii", "chunk", "upload"],
      "complexity": "complex",
      "lineRange": [13, 178]
